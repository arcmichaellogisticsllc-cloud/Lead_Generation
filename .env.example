# Copy to .env and fill in values
# No API keys required for Phase 1 (DuckDuckGo search is keyless)

# Optional: override default data directory
# DATA_DIR=data

# Optional: logging level
# LOG_LEVEL=INFO

# Flask secret key — set a long random string for session security
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=changeme

# Enable Flask debug mode (never set to 1 in production)
# FLASK_DEBUG=0

# Run Playwright browsers headless (set to 1 for server/CI deployments)
# BROWSER_HEADLESS=0

# Limit discovery scan per run (default 500)
# DISCOVER_SCAN=300

# Save per-entity screenshots during discovery (set to 1 to enable)
# DISCOVER_SCREENSHOTS=0

# Your outreach phone number — used as {{sender_phone}} in SMS templates (E.164: +14045550100)
# SENDER_PHONE=

# Auto-start 12-touch cadence for HOT leads found within 48 h (set to 1 to enable)
# AUTO_CADENCE_HOT=0

# Phone number to receive SMS alerts for new HOT leads (E.164 format: +14045550100)
# ALERT_PHONE=

# Twilio credentials for SMS alerts (all three required for SMS to fire)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# Google Places API key — enables phone/website fallback for leads with no profiles
# Requires "Places API" enabled at console.cloud.google.com (Text Search + Place Details)
# GOOGLE_PLACES_API_KEY=
